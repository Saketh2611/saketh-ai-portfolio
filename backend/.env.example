# --- Database (Supabase Postgres) ---
# Get this from Supabase → Project Settings → Database → Connection string (URI, "Session pooler")
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[PROJECT-REF].pooler.supabase.com:5432/postgres

# --- Supabase Storage (for photo + resume PDF uploads) ---
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=portfolio-assets

# --- Groq (LLM for chat answers) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Admin login — set once, then log in with this password.
# The password is hashed into the DB on first startup (see core/security.py bootstrap).
ADMIN_PASSWORD=change-me-before-first-deploy

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-portfolio-domain.com

# --- Embedding model ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Rate limiting ---
CHAT_RATE_LIMIT_PER_MINUTE=10

# --- App ---
ENVIRONMENT=development
